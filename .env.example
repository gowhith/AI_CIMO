# Database
DATABASE_URL=postgresql+psycopg://cimo:cimo@postgres:5432/cimo

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT (CHANGE THIS IN PROD)
JWT_SECRET_KEY=please-change-me-in-production

# IBM watsonx.ai (leave WATSONX_ENABLED=false to use rule-based RCA stub)
WATSONX_ENABLED=false
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Notifications
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
